// Single source of truth for the product version.
//
// Every target inherits these through the project-level build configuration, so
// a release bumps exactly one file. The embedded app extensions MUST report the
// same version as the app: `embeddedBinaryValidationUtility` fails the build
// otherwise, which is why keeping this in one place matters.
//
//   MARKETING_VERSION        the user-visible version ("1.0", "1.1.2")
//   CURRENT_PROJECT_VERSION  the build number, incremented on every release
//
// Use `Scripts/version.sh` to read or bump them; `Scripts/check-version.sh`
// asserts every target agrees.

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
